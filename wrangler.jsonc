// Cloudflare Worker config (replaces the old wrangler.toml — same name, main, assets and D1).
// PAYPAL_SECRET is a runtime secret set in the Cloudflare dashboard: never put it here.
{
  "name": "dr",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",

  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "surveysdb",
      "database_id": "dfe47a68-cef0-4841-946b-aa8112011441"
    }
  ],

  // Paid book PDFs (e.g. Thamoud-Book.pdf), streamed by /api/download/:token
  "r2_buckets": [
    {
      "binding": "BOOKS",
      "bucket_name": "merabtibooks"
    }
  ],

  // Workers Logs: every console.log (e.g. "[paypal] capture-order FAILED {...}") is kept and searchable in
  // Cloudflare → Workers & Pages → dr → Observability. head_sampling_rate 1 = keep 100 % of requests.
  // E-mail alerts for failed payments / downloads (Cloudflare Email Routing; sender alerts@merabti.com).
  // The destination address must stay verified in Email Routing.
  "send_email": [
    {
      "name": "ALERT_EMAIL",
      "destination_address": "merabti.soufiane1@gmail.com"
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },

  "vars": {
    "PAYPAL_CLIENT_ID": "BAAWhfxqQPS33tDpMolG8gomP-zzq2G-a0al_C_9fF4gjXOpKNbfFrTyWxvaf_8t12tL7Nvfyqh1X0vK4Y",
    // LIVE: real payments (api-m.paypal.com). "sandbox" → api-m.sandbox.paypal.com (sandbox client ID + secret)
    "PAYPAL_ENV": "live"
  }
}
