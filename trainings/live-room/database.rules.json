{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "secrets": {
      "$code": {
        ".read": "auth != null && root.child('admins').child(auth.uid).val() === true && root.child('rooms').child($code).child('meta/owner').val() === auth.uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && root.child('rooms').child($code).child('meta/owner').val() === auth.uid"
      }
    },

    "rooms": {
      "$code": {
        ".read": "auth != null && data.child('meta/owner').val() === auth.uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && (!data.exists() || data.child('meta/owner').val() === auth.uid)",
        ".validate": "$code.matches(/^[1-9][0-9]{5}$/)",

        "meta": {
          ".read": "auth != null",
          ".validate": "newData.hasChildren(['owner', 'createdAt', 'expiresAt', 'status', 'locked'])",
          "owner": { ".validate": "newData.val() === auth.uid && (!data.exists() || data.val() === newData.val())" },
          "createdAt": { ".validate": "(!data.exists() && newData.val() === now) || newData.val() === data.val()" },
          "expiresAt": { ".validate": "newData.isNumber() && ((!data.exists() && newData.val() <= now + 10800000) || newData.val() === data.val())" },
          "status": { ".validate": "(newData.val() === 'open' || newData.val() === 'ended') && (data.val() !== 'ended' || newData.val() === 'ended')" },
          "locked": { ".validate": "newData.isBoolean()" },
          "endedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },

        "host": { ".read": "auth != null" },
        "current": { ".read": "auth != null" },
        "reveal": { ".read": "auth != null" },
        "scores": { ".read": "auth != null" },
        "final": { ".read": "auth != null" },

        "members": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && newData.exists() && root.child('rooms').child($code).child('meta/status').val() === 'open' && root.child('rooms').child($code).child('meta/expiresAt').val() > now && (data.exists() || root.child('rooms').child($code).child('meta/locked').val() !== true)",
            ".validate": "newData.hasChildren(['name', 'joinedAt']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 30 && newData.child('joinedAt').isNumber()"
          }
        },

        "presence": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('rooms').child($code).child('members').child($uid).exists())",
            ".validate": "newData.val() === true"
          }
        },

        "answers": {
          "$qid": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && root.child('rooms').child($code).child('members').child($uid).exists() && root.child('rooms').child($code).child('meta/status').val() === 'open' && root.child('rooms').child($code).child('meta/expiresAt').val() > now && root.child('rooms').child($code).child('current/qid').val() === $qid && root.child('rooms').child($code).child('current/state').val() === 'live' && now <= root.child('rooms').child($code).child('current/publishedAt').val() + root.child('rooms').child($code).child('current/duration').val() * 1000 + 1500",
              ".validate": "newData.hasChildren(['v', 'ts']) && newData.child('ts').val() === now && newData.child('v').isString() && newData.child('v').val().length <= 500"
            }
          }
        }
      }
    }
  }
}
